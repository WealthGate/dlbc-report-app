{
  "name": "dlbc-report-app",
  "private": true,
  "version": "2.3.1",
  "main": "electron.cjs",
  "type": "module",
  "homepage": "./",
  "scripts": {
    "test": "node --test tests/reporting.test.mjs",
    "test:rules": "firebase emulators:exec --config firebase.test.json --only firestore --project demo-dlbc-reliability \"node --test tests/firestore.rules.test.mjs\"",
    "test:browser": "firebase emulators:exec --config firebase.test.json --only firestore --project demo-dlbc-reliability \"node --test tests/browser.test.mjs\"",
    "lint": "eslint src",
    "dev": "vite",
    "build": "vite build",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npm run android:sync && npx cap open android",
    "android:run": "npm run android:sync && npx cap run android",
    "android:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-apk.ps1",
    "android:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-apk.ps1 -Install",
    "electron:dev": "concurrently \"cross-env BROWSER=none npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder -w",
    "electron:build:all": "vite build && electron-builder -w -m -l",
    "electron:build:mac": "vite build && electron-builder -m",
    "electron:build:linux": "vite build && electron-builder -l"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "firebase": "^12.6.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "recharts": "^3.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@eslint/js": "^9.39.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.4",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "lucide-react": "^0.555.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "vite": "^7.2.4",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.dlbc.dominica.reports",
    "productName": "DLBC Reporting System",
    "files": [
      "dist/**/*",
      "electron.cjs",
      "assets/icon.ico"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  }
}
