rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userCountryKey() {
      return userDoc().data.countryKey;
    }

    function isAdmin() {
      return isSignedIn() && userDoc().data.role == "admin";
    }

    function isVettingCommitteeChairman() {
      return isSignedIn() && (
        userDoc().data.role.lower().replace('[ -]+', '_') == "vetting_committee_chairman" ||
        userDoc().data.role.lower().replace('[ -]+', '_') == "vetting_committee_chair" ||
        userDoc().data.role.lower().replace('[ -]+', '_') == "committee_chairman"
      );
    }

    function isFinanceReporter() {
      return isSignedIn() && (
        userDoc().data.role == "finance_reporter" ||
        userDoc().data.role == "financial_secretary" ||
        userDoc().data.role == "finance_secretary" ||
        userDoc().data.role == "accountant"
      );
    }

    function canReadCountryReports() {
      return isAdmin() || isVettingCommitteeChairman() || isFinanceReporter();
    }

    function canManageExpenses() {
      return isAdmin() || isVettingCommitteeChairman();
    }

    // The document id is known even before a monthly document exists.
    function isOwnMonthlyDocument(docId) {
      return isSignedIn() && docId.split('__').size() == 2
        && docId.split('__')[0] == userCountryKey()
        && docId.split('__')[1].matches('[0-9]{4}-[0-9]{2}');
    }

    function expensesOf(data) {
      return data.financials is map && data.financials.expenses is list
        ? data.financials.expenses
        : [];
    }

    function canCreateReportWithExpenses() {
      return canManageExpenses() || expensesOf(request.resource.data).size() == 0;
    }

    function canUpdateReportExpenses() {
      return canManageExpenses() || expensesOf(request.resource.data) == expensesOf(resource.data);
    }

    /* USERS */
    match /users/{userId} {
      allow read: if isAdmin() && resource.data.countryKey == userCountryKey();
      allow create: if isAdmin() && request.resource.data.countryKey == userCountryKey()
        && !request.resource.data.keys().hasAny(['password', 'passwordHash']);
      allow update: if isAdmin()
        && resource.data.countryKey == userCountryKey()
        && request.resource.data.countryKey == resource.data.countryKey
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'branch', 'role', 'phone', 'updatedAt', 'updatedBy'])
        && request.resource.data.role in ['user', 'finance_reporter', 'admin', 'vetting_committee_chairman']
        && (userId != request.auth.uid || request.resource.data.role == 'admin');
      allow delete: if isAdmin() && resource.data.countryKey == userCountryKey() && userId != request.auth.uid;
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.role == 'user'
        && request.resource.data.email == request.auth.token.email
        && !request.resource.data.keys().hasAny(['password', 'passwordHash']);
      allow update: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'branch', 'phone', 'country', 'countryKey', 'updatedAt'])
        && (resource.data.get('countryKey', '') == '' || request.resource.data.countryKey == resource.data.countryKey);
    }

    /* REPORTS */
    match /reports/{reportId} {
      allow read: if canReadCountryReports() && resource.data.countryKey == userCountryKey();
      allow read: if canReadCountryReports() && resource.data.country == userDoc().data.country;
      allow read: if isSignedIn() && request.auth.token.email == resource.data.createdBy;
      allow read: if isSignedIn() && request.auth.uid == resource.data.createdByUid;
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.token.email
        && request.resource.data.get('createdByUid', request.auth.uid) == request.auth.uid
        && request.resource.data.countryKey == userCountryKey()
        && canCreateReportWithExpenses();
      allow update: if isSignedIn()
        && (request.auth.token.email == resource.data.createdBy || request.auth.uid == resource.data.get('createdByUid', ''))
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.get('createdByUid', '') == resource.data.get('createdByUid', '')
        && request.resource.data.countryKey == resource.data.countryKey
        && canUpdateReportExpenses();
      allow delete: if isSignedIn()
        && request.auth.token.email == resource.data.createdBy;
      allow update: if isAdmin()
        && request.resource.data.countryKey == userCountryKey()
        && resource.data.countryKey == userCountryKey();
      allow delete: if isAdmin()
        && resource.data.countryKey == userCountryKey();
    }

    /* COUNTRY-WIDE COMBINED SERVICE NOTICES */
    match /combined_service_notices/{noticeId} {
      allow read: if isSignedIn() && resource.data.countryKey == userCountryKey();
      allow create: if isSignedIn()
        && request.resource.data.countryKey == userCountryKey()
        && request.resource.data.createdBy == request.auth.token.email;
      allow update, delete: if isAdmin()
        && resource.data.countryKey == userCountryKey();
      allow update, delete: if isSignedIn()
        && resource.data.createdBy == request.auth.token.email
        && resource.data.countryKey == userCountryKey();
    }

    /* PENDING USERS */
    match /pending_users/{docId} {
      allow read: if isAdmin() && resource.data.countryKey == userCountryKey();
      allow write: if isAdmin() && request.resource.data.countryKey == userCountryKey();
    }

    /* MONTHLY SUMMARIES */
    match /monthly_summaries/{docId} {
      allow read: if canReadCountryReports() && isOwnMonthlyDocument(docId);
      allow write: if canManageExpenses() && isOwnMonthlyDocument(docId) && request.resource.data.countryKey == userCountryKey();
    }

    /* MONTHLY FINANCIAL ENTRIES */
    match /monthly_financial_entries/{docId} {
      allow read: if canReadCountryReports() && isOwnMonthlyDocument(docId);
      allow write: if canManageExpenses() && request.resource.data.countryKey == userCountryKey();
    }

    /* MONTHLY EXPENSE RECORDS */
    match /monthly_expense_records/{docId} {
      allow read: if canReadCountryReports() && resource.data.countryKey == userCountryKey();
      allow write: if canManageExpenses() && request.resource.data.countryKey == userCountryKey();
      allow delete: if canManageExpenses() && resource.data.countryKey == userCountryKey();
    }

    /* MONTHLY AI REPORTS */
    match /monthly_ai_reports/{docId} {
      allow read: if canReadCountryReports() && isOwnMonthlyDocument(docId);
    }

    /* EVERYTHING ELSE */
    match /{collectionName}/{document=**} {
      // User-account restrictions above must not be bypassed by the admin fallback.
      allow read, write: if collectionName != 'users' && isAdmin();
    }
  }
}
